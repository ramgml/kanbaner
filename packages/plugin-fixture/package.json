{
  "name": "@kanbaner/plugin-fixture",
  "version": "0.1.0-rc.0",
  "private": true,
  "type": "module",
  "description": "Контрактный fixture-плагин Kanbaner. Использует только публичный @kanbaner/plugin-sdk.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kanbaner/plugin-sdk": "workspace:*"
  }
}

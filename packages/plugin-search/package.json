{
  "name": "@kanbaner/plugin-search",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Глобальный поиск Kanbaner: агрегирует активных SearchProvider-ов через публичный SDK и открывает ресурсы по ResourceRef.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "files": [
    "dist",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kanbaner/plugin-sdk": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "lucide-react": "1.70.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

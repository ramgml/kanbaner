{
  "name": "@kanbaner/plugin-tasks",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Доменный плагин задач Kanbaner: модель, схемы, Store-контракт и ResourceRef без UI и физического хранения.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kanbaner/plugin-sdk": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  }
}

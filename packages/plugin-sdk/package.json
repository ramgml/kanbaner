{
  "name": "@kanbaner/plugin-sdk",
  "version": "0.2.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Публичный SDK плагинов Kanbaner. Каркас без доменной логики.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "semver": "7.8.6"
  },
  "devDependencies": {
    "@types/semver": "7.8.0"
  }
}

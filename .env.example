# Каталог данных Kanbaner. Необязателен: при пустом значении используются
# каталоги ОС (Linux: ~/.local/share/kanbaner/data,
# Windows: %APPDATA%\Kanbaner\data).
KANBANER_DATA_DIR=

# Корень проекта для OpenCode Location. Обычно не нужен: production server
# определяет его от apps/web, запуск из корня — от текущего каталога.
KANBANER_PROJECT_DIR=

# Bearer token для внешнего HTTP API. Секрет задаётся только локально
# и никогда не коммитится. Пустое значение отключает API, кроме health.
KANBANER_API_TOKEN=

# Базовый URL для @kanbaner/cli. Сервер его не использует; CLI читает значение
# из окружения процесса и не загружает .env самостоятельно.
KANBANER_API_URL=http://127.0.0.1:3000

{
  "name": "kanbaner",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.22.2",
    "pnpm": "12.18.x"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @kanbaner/web dev",
    "build": "pnpm build:packages && pnpm --filter @kanbaner/web build",
    "build:packages": "pnpm --filter @kanbaner/plugin-sdk build && pnpm --filter @kanbaner/kernel build && pnpm --filter @kanbaner/storage-sqlite build && pnpm --filter @kanbaner/plugin-fixture build && pnpm --filter @kanbaner/plugin-tasks build",
    "start": "pnpm --filter @kanbaner/web start",
    "typecheck": "pnpm build:packages && tsc -p tsconfig.tools.json --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "test:sqlite": "vitest run apps/web/src/server/sqlite-smoke.test.ts",
    "storage:restore": "pnpm build:packages && node scripts/restore.mjs",
    "check:composition": "pnpm build:packages && pnpm --filter @kanbaner/web check:composition",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@kanbaner/kernel": "workspace:*",
    "@kanbaner/plugin-sdk": "workspace:*",
    "@kanbaner/storage-sqlite": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}

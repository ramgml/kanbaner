{
  "name": "@kanbaner/web",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Веб-приложение Kanbaner: UI shell и composition root.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "node scripts/server.mjs",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "check:composition": "node scripts/check-composition-root.ts"
  },
  "dependencies": {
    "@kanbaner/kernel": "workspace:*",
    "@kanbaner/plugin-sdk": "workspace:*",
    "@kanbaner/plugin-notes": "workspace:*",
    "@kanbaner/opencode": "workspace:*",
    "@kanbaner/plugin-projects": "workspace:*",
    "@kanbaner/plugin-search": "workspace:*",
    "@kanbaner/storage-sqlite": "workspace:*",
    "@kanbaner/task-ui": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-sqlite3": "13.0.3",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0"
  }
}
